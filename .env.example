# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Conexión directa (para psql, migraciones y `npm run verificar:permisos`).
# Sin esto el verificador de permisos no corre solo: hay que sacar la matriz
# por otra vía y pasársela con --matriz. Ver docs/coordinacion.md.
DATABASE_URL=

# Mail (bloque 3 · pendiente de definir proveedor)
# RESEND_API_KEY=

# ARCA / Facturación Electrónica (wsfev1) — certificado de CAMPA SRL,
# CUIT 30715502670, alias "campa-facturacion", vence 24/08/2028.
# NUNCA subir el .key/.crt reales al repo — solo estas variables al
# entorno del servidor (Vercel). Ver docs/propuestas/comprobantes_y_facturacion.md.
# ARCA_CUIT=30715502670
# ARCA_CERT_PEM=
# ARCA_KEY_PEM=

# A qué ARCA se le habla. Es la única diferencia entre ensayar y emitir de
# verdad, así que NO tiene default: si falta o no dice exactamente "true", se
# usa homologación.
#
#   (vacío o cualquier cosa) → HOMOLOGACIÓN · wsaahomo/wswhomo · no emite nada real
#   true                     → PRODUCCIÓN   · comprobantes fiscales de verdad,
#                              que consumen numeración y no se pueden borrar
#
# El default seguro es deliberado: olvidarse de esta variable tiene que llevar
# al lado que no hace daño. Lo caro es lo contrario — descubrir que se estaba
# en producción por una factura real que nadie quería emitir.
ARCA_PRODUCCION=
